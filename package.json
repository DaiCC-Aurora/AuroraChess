{
  "name": "aurora-chess",
  "version": "0.1.0",
  "private": true,
  "description": "AuroraChess - play and learn chess against an adjustable-strength engine, on phone, web and smartwatch.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:setup": "node scripts/setup-engine.mjs",
    "engine:smoke": "node scripts/engine-smoke.mjs",
    "pieces:setup": "node scripts/setup-pieces.mjs",
    "verify": "npm run typecheck && npm test && npm run engine:smoke && npm run build"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "next": "^16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
